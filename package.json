{
  "name": "moodlia-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app for Moodle course and student analysis, connecting with or without the MoodlIA plugin.",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "node --test \"tests/*.test.mjs\" && vitest run",
    "check": "npm run typecheck && npm test && npm run smoke",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "moodlia": "0.5.3"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "electron@45.2.3": true
  }
}
