{
  "name": "moodlia-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app for Moodle course and student analysis, connecting with or without the MoodlIA plugin.",
  "license": "MIT",
  "author": "Pablo Gallego",
  "homepage": "https://gafapa.github.io/moodlia-analyzer/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gafapa/moodlia-analyzer.git"
  },
  "bugs": {
    "url": "https://github.com/gafapa/moodlia-analyzer/issues"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "node --test \"tests/*.test.mjs\" && vitest run",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "smoke:packaged": "node scripts/smoke.mjs --packaged",
    "package": "npm run build && electron-builder --publish never",
    "check": "npm run typecheck && npm test && npm run smoke"
  },
  "dependencies": {
    "moodlia": "0.5.3"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "electron@45.2.3": true
  },
  "build": {
    "appId": "com.moodlia.analyzer",
    "productName": "MoodlIA Analyzer",
    "artifactName": "MoodlIA-Analyzer-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "npmRebuild": false,
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MoodlIA-Analyzer-${version}-win-${arch}-setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Education",
      "synopsis": "Moodle course and student analysis"
    }
  }
}
